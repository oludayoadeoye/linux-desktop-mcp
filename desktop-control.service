[Unit]
Description=Local KDE Desktop Control MCP Server
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/projects/linux-desktop-mcp
ExecStart=%h/.local/bin/uv run --no-sync python main.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
